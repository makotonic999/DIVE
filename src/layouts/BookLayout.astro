---
/**
 * BookLayout.astro
 * メインレイアウト — 紙の本のような読書体験を提供する。
 * 背景 #FBF9F5, テキスト #2C2C2C, 最大幅 700px の中央配置。
 */
export interface Props {
  title: string;
  description?: string;
  part?: string;
  chapter?: number;
  publishedAt?: Date;
}

const {
  title,
  description = 'DIVE — 0と1の物理からAIまでを繋ぐフルスタック技術全史',
  part,
  chapter,
  publishedAt,
} = Astro.props;

const formattedDate = publishedAt
  ? new Intl.DateTimeFormat('ja-JP', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(publishedAt)
  : null;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title} | DIVE</title>

    <!-- KaTeX CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      integrity="sha384-5TcZemv2l/9On385z///+d7MSYlvIEw9FuZTIdZ14vJLqWphw7e7ZPuOiCHJcFCP"
      crossorigin="anonymous"
    />

    <!-- Google Fonts: Noto Serif JP + Noto Sans JP + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Serif+JP:wght@400;500;700&family=JetBrains+Mono:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <style>
      /* ──────────────────────────────────────────────
         グローバル基盤スタイル
         ────────────────────────────────────────────── */
      :root {
        --color-paper: #fbf9f5;
        --color-ink: #2c2c2c;
        --color-ink-light: #555555;
        --color-ink-muted: #888888;
        --color-border: #e8e3d8;
        --color-accent: #8b6914;
        --reading-width: 700px;
        --side-padding: 1.5rem;
      }

      html {
        background-color: var(--color-paper);
        color: var(--color-ink);
        font-family: 'Noto Serif JP', Georgia, 'Times New Roman', serif;
        font-size: 17px;
        line-height: 1.875;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        scroll-behavior: smooth;
      }

      /* ページ全体を左右に薄いページ端を見せる */
      body {
        background-color: var(--color-paper);
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }

      /* KaTeX display equations: 余白調整 */
      .katex-display {
        overflow-x: auto;
        padding: 0.5rem 0;
      }

      /* Shiki コードブロックのスクロール対応 */
      pre.astro-code {
        border-radius: 0.5rem;
        overflow-x: auto;
      }
    </style>
  </head>

  <body>
    <!-- ────────── サイトヘッダー ────────── -->
    <header
      style="
        border-bottom: 1px solid var(--color-border);
        padding: 1rem var(--side-padding);
        background-color: var(--color-paper);
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(4px);
      "
    >
      <div
        style="
          max-width: var(--reading-width);
          margin: 0 auto;
          display: flex;
          align-items: center;
          justify-content: space-between;
        "
      >
        <a
          href="/"
          style="
            font-family: 'Noto Sans JP', sans-serif;
            font-weight: 700;
            font-size: 1.125rem;
            color: var(--color-ink);
            text-decoration: none;
            letter-spacing: 0.05em;
          "
        >
          DIVE
        </a>
        <nav>
          <a
            href="/"
            style="
              font-family: 'Noto Sans JP', sans-serif;
              font-size: 0.8125rem;
              color: var(--color-ink-muted);
              text-decoration: none;
              margin-left: 1.5rem;
            "
          >
            目次
          </a>
          <a
            href="/about"
            style="
              font-family: 'Noto Sans JP', sans-serif;
              font-size: 0.8125rem;
              color: var(--color-ink-muted);
              text-decoration: none;
              margin-left: 1.5rem;
            "
          >
            About
          </a>
        </nav>
      </div>
    </header>

    <!-- ────────── メインコンテンツ ────────── -->
    <main
      style="
        max-width: var(--reading-width);
        margin: 0 auto;
        padding: 3rem var(--side-padding) 6rem;
      "
    >
      <!-- チャプターヘッダー（part / chapter が渡された場合のみ表示） -->
      {
        (part || chapter) && (
          <header style="margin-bottom: 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border);">
            {part && (
              <p
                style="
                  font-family: 'Noto Sans JP', sans-serif;
                  font-size: 0.75rem;
                  letter-spacing: 0.12em;
                  text-transform: uppercase;
                  color: var(--color-accent);
                  margin: 0 0 0.5rem;
                "
              >
                {part}
              </p>
            )}
            {chapter && (
              <p
                style="
                  font-family: 'Noto Sans JP', sans-serif;
                  font-size: 0.875rem;
                  color: var(--color-ink-muted);
                  margin: 0 0 0.75rem;
                "
              >
                第 {chapter} 章
              </p>
            )}
            <h1
              style="
                font-family: 'Noto Sans JP', sans-serif;
                font-size: 2rem;
                font-weight: 700;
                line-height: 1.3;
                letter-spacing: -0.02em;
                color: var(--color-ink);
                margin: 0;
              "
            >
              {title}
            </h1>
            {formattedDate && (
              <time
                style="
                  display: block;
                  margin-top: 1rem;
                  font-family: 'Noto Sans JP', sans-serif;
                  font-size: 0.8125rem;
                  color: var(--color-ink-muted);
                "
              >
                {formattedDate}
              </time>
            )}
          </header>
        )
      }

      <!-- 本文: prose クラスで Tailwind Typography を適用 -->
      <article class="prose prose-lg max-w-none">
        <slot />
      </article>
    </main>

    <!-- ────────── フッター ────────── -->
    <footer
      style="
        border-top: 1px solid var(--color-border);
        padding: 2rem var(--side-padding);
        text-align: center;
      "
    >
      <p
        style="
          font-family: 'Noto Sans JP', sans-serif;
          font-size: 0.8125rem;
          color: var(--color-ink-muted);
          margin: 0;
        "
      >
        &copy; 2026 DIVE — Deep Interactive Virtual Encyclopedia
      </p>
    </footer>
  </body>
</html>
