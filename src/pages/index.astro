---
/**
 * src/pages/index.astro
 * DIVE トップページ — シラバス（全7Part / 21章）の目次を表示する。
 */
import BookLayout from '../layouts/BookLayout.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('chapters');
chapters.sort((a, b) => (a.data.chapter ?? 0) - (b.data.chapter ?? 0));

// 章をPartごとにグループ化
const parts = [
  {
    id: 1,
    title: 'Part 1: 物理・電子・論理回路',
    subtitle: 'トランジスタの発明から、クロックとレジスタ、そして自作CPUへ',
    chapters: [1, 2, 3],
  },
  {
    id: 2,
    title: 'Part 2: アセンブリ・実行モデル',
    subtitle: '機械語とCの世界、スタック・ヒープの真実、ポインタの解体',
    chapters: [4, 5, 6],
  },
  {
    id: 3,
    title: 'Part 3: カーネルと仮想化',
    subtitle: 'UNIXとシステムコール、仮想メモリ、namespaces・cgroups',
    chapters: [7, 8, 9],
  },
  {
    id: 4,
    title: 'Part 4: 高並列・DB・ランタイム',
    subtitle: 'C10KとEpoll、B-TreeとWAL、GCの裏側',
    chapters: [10, 11, 12],
  },
  {
    id: 5,
    title: 'Part 5: ネットワーク・SRE',
    subtitle: 'TCP/IP、TLS 1.3、CAP定理とカオスエンジニアリング',
    chapters: [13, 14, 15],
  },
  {
    id: 6,
    title: 'Part 6: 並列ハード・数学基盤',
    subtitle: 'GPU超並列、行列演算とベクトル空間、偏微分・勾配降下法',
    chapters: [16, 17, 18],
  },
  {
    id: 7,
    title: 'Part 7: 確率とAI・LLM',
    subtitle: '自作ニューラルネット、言語の分散表現、TransformerとSelf-Attention',
    chapters: [19, 20, 21],
  },
];
---

<BookLayout title="DIVE — 技術全史">
  <!-- ヒーローセクション -->
  <div style="text-align: center; padding: 3rem 0 4rem;">
    <p
      style="
        font-family: 'Noto Sans JP', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #8B6914;
        margin: 0 0 1rem;
      "
    >
      Deep Interactive Virtual Encyclopedia
    </p>
    <h1
      style="
        font-family: 'Noto Sans JP', sans-serif;
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        color: #2C2C2C;
        margin: 0 0 1.5rem;
        line-height: 1.2;
      "
    >
      0と1の物理からAIまでを繋ぐ<br />
      フルスタック技術全史
    </h1>
    <p
      style="
        font-family: 'Noto Serif JP', serif;
        font-size: 1rem;
        color: #555555;
        max-width: 500px;
        margin: 0 auto;
        line-height: 1.9;
      "
    >
      非エンジニアが読めば、すべてのブラックボックスを消し去り<br />
      最強のエンジニアになれる技術エンタメ小説
    </p>
  </div>

  <hr style="border: none; border-top: 1px solid #E8E3D8; margin: 0 0 3rem;" />

  <!-- シラバス目次 -->
  <section>
    <h2
      style="
        font-family: 'Noto Sans JP', sans-serif;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #888888;
        margin: 0 0 2rem;
      "
    >
      シラバス — 全7Part / 21章
    </h2>

    {parts.map((part) => (
      <div style="margin-bottom: 2.5rem;">
        <!-- Part ヘッダー -->
        <div
          style="
            background-color: #F0EBE0;
            border-radius: 0.375rem;
            padding: 1rem 1.25rem;
            margin-bottom: 0.75rem;
          "
        >
          <p
            style="
              font-family: 'Noto Sans JP', sans-serif;
              font-size: 0.6875rem;
              letter-spacing: 0.1em;
              text-transform: uppercase;
              color: #8B6914;
              margin: 0 0 0.25rem;
            "
          >
            Part {part.id}
          </p>
          <h3
            style="
              font-family: 'Noto Sans JP', sans-serif;
              font-size: 1rem;
              font-weight: 600;
              color: #2C2C2C;
              margin: 0 0 0.25rem;
            "
          >
            {part.title.replace(`Part ${part.id}: `, '')}
          </h3>
          <p
            style="
              font-family: 'Noto Serif JP', serif;
              font-size: 0.8125rem;
              color: #555555;
              margin: 0;
            "
          >
            {part.subtitle}
          </p>
        </div>

        <!-- 章リスト -->
        <ul style="list-style: none; margin: 0; padding: 0;">
          {part.chapters.map((chNum) => {
            const ch = chapters.find((c) => c.data.chapter === chNum);
            return (
              <li
                style="
                  display: flex;
                  align-items: baseline;
                  gap: 1rem;
                  padding: 0.625rem 0;
                  border-bottom: 1px dashed #E8E3D8;
                "
              >
                <span
                  style="
                    font-family: 'Noto Sans JP', sans-serif;
                    font-size: 0.75rem;
                    color: #888888;
                    min-width: 3rem;
                    flex-shrink: 0;
                  "
                >
                  Ch.{String(chNum).padStart(2, '0')}
                </span>
                {ch ? (
                  <a
                    href={`/chapters/${ch.slug}`}
                    style="
                      font-family: 'Noto Serif JP', serif;
                      font-size: 0.9375rem;
                      color: #2C2C2C;
                      text-decoration: none;
                      line-height: 1.5;
                      border-bottom: 1px solid transparent;
                      transition: border-color 0.15s;
                    "
                  >
                    {ch.data.title}
                  </a>
                ) : (
                  <span
                    style="
                      font-family: 'Noto Serif JP', serif;
                      font-size: 0.9375rem;
                      color: #BBBBBB;
                    "
                  >
                    — 執筆準備中
                  </span>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>
</BookLayout>
